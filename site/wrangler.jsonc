{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leals-recipes",
  "account_id": "9a3d9a6db3bf24541054da8dfa23b580",
  "compatibility_date": "2026-09-28",
  // The family cookbook is public on purpose.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "recipes.leals.casa", "custom_domain": true }],
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
